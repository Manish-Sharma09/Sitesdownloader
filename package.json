    "domhandler": "^6.0.1",
    "js-beautify": "^2.0.3",
    "jszip": "^3.10.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
