{
  "name": "landing-page-download",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "imports": {
    "#transport": {
      "workerd": "./src/lib/transport.workers.ts",
      "default": "./src/lib/transport.node.ts"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
