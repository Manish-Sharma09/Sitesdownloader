---
import { SITE } from '../config';
---

{
  SITE.telegramBot && (
    <section class="wrap" aria-label="Telegram bot">
      <div class="telegram">
        <svg class="plane" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
          <path
            d="M21.5 3.6 2.9 10.8c-1.3.5-1.3 1.2-.2 1.6l4.8 1.5 1.8 5.6c.2.6.1.9.8.9.5 0 .7-.2 1-.5l2.4-2.3 4.9 3.6c.9.5 1.6.2 1.8-.8l3.2-15.2c.3-1.3-.5-1.9-1.4-1.5Zm-3 3.6-8.6 7.8-.3 3.6-1.6-5 9.9-6.3c.5-.3.9-.1.6 0Z"
            fill="currentColor"
          />
        </svg>
        <p>Download any website with the Telegram bot</p>
        <a href={`https://t.me/${SITE.telegramBot}`} target="_blank" rel="noopener noreferrer">
          @{SITE.telegramBot}
        </a>
      </div>
    </section>
  )
}

<style>
  .telegram {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: var(--s-5) clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .plane {
    flex: none;
    color: var(--accent);
  }

  p {
    flex: 1 1 16rem;
    font-weight: 620;
  }

  a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--s-4);
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 680;
    text-decoration: none;
    transition: background-color 160ms var(--ease-out);
  }

  a:hover {
    background: var(--accent-strong);
  }

  a:focus-visible {
    outline-color: var(--accent);
  }
</style>
