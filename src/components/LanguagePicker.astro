---
// Language menu: real links to the same page in every language, so it works without JavaScript
// and search engines can follow it. The small script only closes it on outside click or Escape.
import { LANGS, LANGUAGES, basePath, getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = basePath(Astro.url);
---

<details class="lang-picker" data-lang-picker>
  <summary aria-label={`${t.common.languageMenuLabel}: ${LANGUAGES[lang].label}`}>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25"></circle>
      <path d="M2.75 10h14.5M10 2.75c2 2 3 4.4 3 7.25s-1 5.25-3 7.25c-2-2-3-4.4-3-7.25s1-5.25 3-7.25Z"></path>
    </svg>
    <span class="code">{lang.toUpperCase()}</span>
  </summary>
  <ul>
    {
      LANGS.map((l) => (
        <li>
          <a
            href={localizePath(base, l)}
            hreflang={LANGUAGES[l].hreflang}
            lang={LANGUAGES[l].htmlLang}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span>{LANGUAGES[l].label}</span>
            <span class="code">{l.toUpperCase()}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  for (const picker of document.querySelectorAll<HTMLDetailsElement>('[data-lang-picker]')) {
    document.addEventListener('click', (event) => {
      if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
    });
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && picker.open) {
        picker.open = false;
        picker.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .lang-picker {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    height: 2.75rem;
    padding: 0 var(--s-3);
    border: 0;
    border-radius: var(--r-pill);
    color: var(--header-ink);
    font-size: 0.75rem;
    font-weight: 650;
    list-style: none;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  [open] summary {
    background: var(--header-hover);
  }

  summary svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  ul {
    position: absolute;
    top: calc(100% + var(--s-2));
    right: 0;
    z-index: 10;
    min-width: 12rem;
    margin: 0;
    padding: var(--s-2);
    list-style: none;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      inset 0 1px 0 var(--highlight),
      var(--shadow-md);
    transform-origin: top right;
    animation: menu-in 180ms var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border-radius: var(--r-md);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
  }

  a:hover {
    background: var(--surface-2);
  }

  a[aria-current] {
    font-weight: 700;
  }

  a[aria-current] .code {
    color: var(--ink);
  }

  a .code {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
