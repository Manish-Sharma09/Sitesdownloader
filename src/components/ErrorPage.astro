---
// Shared body of the 404 and 500 pages: the message and the way back on one side, and on the other
// the status code set very large, tone-on-tone, with the brand's zipper running through it and
// coming apart halfway (the archive that didn't make it). Both pages render on demand in the
// language of the requested URL, so the header, footer and every label are in that language too.
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  code: '404' | '500';
  heading: string;
  /** Plain text, or HTML when `html` is set (the 500 text links to the contact page). */
  text: string;
  html?: boolean;
  button: string;
  /** The address that was asked for, shown on the 404 page. */
  path?: string;
}

const { code, heading, text, html = false, button, path } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const anchor = (id: string) => `${home === '/' ? '' : home}/#${id}`;
const LINKS = [
  { href: anchor('how-it-works'), label: t.nav.howItWorks },
  { href: anchor('faq'), label: t.nav.faq },
  { href: localizePath('/contact', lang), label: t.footer.contact },
];
---

<section class="error stage">
  <div class="stage-grid"></div>
  <div class="inner wrap">
    <div class="copy">
      {path && <p class="path" translate="no"><code>{path}</code></p>}
      <h1>{heading}</h1>
      {html ? <p class="text" set:html={text} /> : <p class="text">{text}</p>}
      <div class="actions">
        <a class="btn btn-primary" href={home}>
          <span>{button}</span>
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="16" height="16"><path d="M4 10h11m0 0-4-4m4 4-4 4"></path></svg>
          </span>
        </a>
        <ul class="links">
          {LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="art" aria-hidden="true">
      <p class="digits" translate="no">{code}</p>
      <div class="zipper">
        <span class="closed"></span>
        <span class="pull"></span>
        <span class="open open-top"></span>
        <span class="open open-bottom"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .error {
    --glow-x: 72%;
    --glow-y: 55%;
    --grid-mask: radial-gradient(55% 90% at 72% 100%, black 10%, transparent 75%);
    display: grid;
    align-items: center;
    min-height: 100dvh;
    padding-block: 7rem 4rem;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  /* ---- Message --------------------------------------------------------------------------- */
  .path {
    max-width: 100%;
    margin-bottom: var(--s-5);
  }

  .path code {
    display: inline-block;
    max-width: 100%;
    padding: 0.375rem var(--s-4);
    overflow: hidden;
    border-radius: var(--r-pill);
    background: var(--shell);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    white-space: nowrap;
    text-overflow: ellipsis;
    vertical-align: bottom;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 5rem);
    font-weight: 700;
    font-stretch: 90%;
    line-height: 0.96;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .text {
    max-width: 32rem;
    margin-top: var(--s-5);
    color: var(--muted);
    font-size: var(--fs-md);
    text-wrap: pretty;
  }

  .text :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-7);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .links a:hover {
    color: var(--ink);
    background: var(--shell);
  }

  /* ---- The code, with a zipper coming apart across it ----------------------------------------- */
  .art {
    position: relative;
    display: grid;
    place-items: center;
    container-type: inline-size;
  }

  .digits {
    color: var(--surface-2);
    font-family: var(--font-display);
    font-size: 44cqi;
    font-weight: 700;
    font-stretch: 85%;
    line-height: 0.85;
    letter-spacing: -0.05em;
    -webkit-text-stroke: 1px var(--line-strong);
    user-select: none;
  }

  .zipper {
    --tooth: 6px;
    --teeth: var(--bg);
    position: absolute;
    top: 50%;
    left: -6%;
    right: -6%;
    height: 1.25rem;
    margin-top: -0.625rem;
    transform: rotate(-6deg);
  }

  /* Interlocked teeth up to the pull... */
  .closed {
    position: absolute;
    inset: 0 auto 0 0;
    width: 48%;
    border-radius: 3px 0 0 3px;
    background-color: var(--accent);
    background-image:
      repeating-linear-gradient(90deg, var(--teeth) 0 var(--tooth), transparent var(--tooth) calc(var(--tooth) * 2)),
      repeating-linear-gradient(90deg, transparent 0 var(--tooth), var(--teeth) var(--tooth) calc(var(--tooth) * 2));
    background-size:
      100% 45%,
      100% 45%;
    background-position:
      0 10%,
      0 90%;
    background-repeat: no-repeat;
  }

  /* ...then the two halves part. */
  .open {
    position: absolute;
    left: 50%;
    right: 0;
    height: 50%;
    background-color: var(--accent);
    background-image: repeating-linear-gradient(90deg, var(--teeth) 0 var(--tooth), transparent var(--tooth) calc(var(--tooth) * 2));
    transform-origin: 0 50%;
    animation: part 1200ms var(--ease-spring) 300ms backwards;
  }

  .open-top {
    top: 0;
    border-radius: 0 3px 0 0;
    transform: rotate(-9deg);
  }

  .open-bottom {
    bottom: 0;
    border-radius: 0 0 3px 0;
    transform: rotate(9deg);
  }

  .pull {
    position: absolute;
    top: 50%;
    left: 47%;
    z-index: 1;
    width: 2.5rem;
    height: 1.75rem;
    margin-top: -0.875rem;
    border-radius: 7px;
    background: var(--ink);
    box-shadow:
      0 0 0 2px var(--accent),
      var(--shadow-md);
    animation: pull-back 1200ms var(--ease-spring) 300ms backwards;
  }

  .pull::after {
    content: '';
    position: absolute;
    inset: 0.55rem 0.7rem;
    border-radius: 2px;
    background: var(--accent);
  }

  @keyframes part {
    from {
      transform: rotate(0deg);
    }
  }

  @keyframes pull-back {
    from {
      transform: translateX(45cqi);
    }
  }

  @media (max-width: 860px) {
    .error {
      align-items: start;
      padding-top: 6.5rem;
    }

    .inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .art {
      order: -1;
      max-width: 26rem;
      width: 100%;
      justify-self: center;
    }

    .zipper {
      left: 0;
      right: 0;
    }
  }
</style>
