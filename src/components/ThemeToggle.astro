---
// Light/dark switch. The page is dark unless the visitor picks light here. The icon is a sun in
// light mode that turns into a moon in dark mode (driven by the --theme-dark token, so it is right
// before any JavaScript runs). Switching
// reveals the new theme in a circle growing from the button, using a same-document view
// transition; browsers without view transitions, or visitors with reduced motion, switch instantly.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  class="theme-toggle"
  type="button"
  aria-label={t.common.themeToDark}
  data-theme-toggle
  data-label-light={t.common.themeToLight}
  data-label-dark={t.common.themeToDark}
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <mask id="theme-toggle-moon">
      <rect width="24" height="24" fill="white"></rect>
      <circle class="moon-cut" cx="24" cy="2" r="7" fill="black"></circle>
    </mask>
    <circle class="core" cx="12" cy="12" r="5" mask="url(#theme-toggle-moon)"></circle>
    <g class="rays">
      <path d="M12 1.5v2.25M12 20.25v2.25M22.5 12h-2.25M3.75 12H1.5M19.42 4.58l-1.6 1.6M6.18 17.82l-1.6 1.6M19.42 19.42l-1.6-1.6M6.18 6.18l-1.6-1.6"></path>
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  // Browser UI colour (address bar on mobile) for each theme; matches the page canvas.
  const THEME_COLOR = { light: '#f3f4f7', dark: '#07080b' } as const;

  type Theme = keyof typeof THEME_COLOR;
  const current = (): Theme => (root.dataset.theme as Theme) ?? 'dark';

  function sync() {
    const theme = current();
    button.setAttribute('aria-label', (theme === 'dark' ? button.dataset.labelLight : button.dataset.labelDark) ?? '');
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.content = THEME_COLOR[theme];
    }
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Private mode or blocked storage: the choice lasts for this page only.
    }
    sync();
  }

  button.addEventListener('click', () => {
    const next: Theme = current() === 'dark' ? 'light' : 'dark';
    if (!document.startViewTransition || reducedMotion.matches) {
      apply(next);
      return;
    }

    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    root.classList.add('theme-switching');
    const transition = document.startViewTransition(() => apply(next));
    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 700, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    transition.finished.finally(() => root.classList.remove('theme-switching'));
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--header-ink);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .theme-toggle:hover {
    background: var(--header-hover);
  }

  .theme-toggle:active {
    transform: scale(0.94);
  }

  svg {
    overflow: visible;
  }

  .core,
  .moon-cut,
  .rays {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 500ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .core {
    fill: currentColor;
    transform: scale(calc(1 + var(--theme-dark) * 0.6));
  }

  /* The cut-out slides over the sun to leave a crescent. */
  .moon-cut {
    transform: translate(calc(var(--theme-dark) * -8px), calc(var(--theme-dark) * 5px));
  }

  .rays {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    opacity: calc(1 - var(--theme-dark));
    transform: rotate(calc(var(--theme-dark) * 90deg)) scale(calc(1 - var(--theme-dark) * 0.5));
  }
</style>
