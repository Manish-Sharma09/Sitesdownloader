---
import { MAX_PAGES } from '../lib/manifest';
import { LANGUAGES, getLangFromUrl, useTranslations } from '../i18n/utils';
import ArchiveScene from './ArchiveScene.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { hero } = t;
const option = (name: keyof typeof hero.options) => ({ name, ...hero.options[name] });
const OPTIONS = (['cleanCopy', 'simplified', 'renameAssets', 'keepStructure', 'prettify', 'pickFiles'] as const).map(option);
const DEVICES = (['desktop', 'mobile', 'both'] as const).map((value) => ({ value, label: hero.devices[value] }));
const OUTPUTS = (['zip', 'single'] as const).map((value) => ({ value, label: hero.outputs[value] }));
// 20px line icons for the device and format switches.
const ICONS: Record<string, string> = {
  desktop: '<rect x="2.75" y="3.75" width="14.5" height="10" rx="1.75"/><path d="M7 16.75h6M10 13.75v3"/>',
  mobile: '<rect x="5.75" y="2.75" width="8.5" height="14.5" rx="2"/><path d="M9.25 14.5h1.5"/>',
  both: '<rect x="2.25" y="4.25" width="11.5" height="8.5" rx="1.5"/><path d="M5.5 16h4.5M7.75 12.75V16"/><rect x="13" y="7.25" width="5" height="9.5" rx="1.25"/>',
  zip: '<path d="M5.5 2.75h6l3.75 3.75v10a1.75 1.75 0 0 1-1.75 1.75h-8a1.75 1.75 0 0 1-1.75-1.75V4.5A1.75 1.75 0 0 1 5.5 2.75Z"/><path d="M11.25 2.75V6.5H15M8.75 2.75v1.5m1.5 0v1.5m-1.5 0v1.5m1.5 0v1.5"/><rect x="8.25" y="10.25" width="2.5" height="3" rx=".75"/>',
  single: '<path d="M5.5 2.75h6l3.75 3.75v10a1.75 1.75 0 0 1-1.75 1.75h-8a1.75 1.75 0 0 1-1.75-1.75V4.5A1.75 1.75 0 0 1 5.5 2.75Z"/><path d="M11.25 2.75V6.5H15M8.5 10.5 7 12l1.5 1.5m3-3L13 12l-1.5 1.5"/>',
};
// Keep the last two words together so neither headline line ends on a lone word.
const keep = (line: string) => line.replace(/ (\S+)$/, ' $1');
const title = keep(hero.title);
const titleAccent = keep(hero.titleAccent);
// The longer headline line, in characters: long translations are set smaller (see h1 below).
const headlineChars = Math.max([...hero.title].length, [...hero.titleAccent].length);
// Strings the browser scripts need, in this page's language.
const clientText = {
  lang,
  locale: LANGUAGES[lang].htmlLang,
  maxPages: MAX_PAGES,
  hero,
  status: t.status,
  errors: { emptyUrl: t.errors.emptyUrl, tooManyPages: t.errors.tooManyPages },
  result: t.result,
};
---

<section class="hero stage" id="top" aria-labelledby="page-title" data-tilt-area>
  <div class="stage-grid"></div>
  <div class="hero-inner wrap">
    <div class="copy">
      <h1 id="page-title" style={`--chars: ${headlineChars}`}>
        <span class="line">{title}</span>
        <span class="line accent">{titleAccent}</span>
      </h1>
      <p class="lead">{hero.lead}</p>

      <div class="console bezel">
        <form id="save-form" class="core" data-mode="single" novalidate>
          <fieldset class="segmented modes">
            <legend class="visually-hidden">{hero.modeLegend}</legend>
            <label><input type="radio" name="mode" value="single" checked /><span>{hero.modes.single}</span></label>
            <label><input type="radio" name="mode" value="multi" /><span>{hero.modes.multi}</span></label>
          </fieldset>

          <div class="entry entry-single">
            <label for="url" class="field-label">{hero.fieldLabel}</label>
            <div class="field">
              <svg class="field-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
                <circle cx="10" cy="10" r="7.25"></circle>
                <path d="M2.75 10h14.5M10 2.75c2 2 3 4.4 3 7.25s-1 5.25-3 7.25c-2-2-3-4.4-3-7.25s1-5.25 3-7.25Z"></path>
              </svg>
              <input
                id="url"
                name="url"
                type="url"
                inputmode="url"
                autocomplete="url"
                autocapitalize="off"
                spellcheck="false"
                placeholder={hero.placeholder}
                aria-describedby="status"
              />
              <button type="submit" class="btn btn-primary save" data-save>
              <span>{hero.save}</span>
              <span class="btn-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 3.5v9.5m0 0 4-4m-4 4-4-4M4.5 16.5h11"></path></svg>
              </span>
            </button>
            </div>
          </div>

          <div class="entry entry-multi" hidden>
            <label for="urls" class="field-label">{hero.multiFieldLabel}</label>
            <div class="field field-multi">
              <textarea
                id="urls"
                name="urls"
                rows="4"
                autocapitalize="off"
                spellcheck="false"
                placeholder={hero.multiPlaceholder.replace('{max}', String(MAX_PAGES))}
                aria-describedby="url-count status"></textarea>
            </div>
            <div class="multi-bar">
              <button type="button" class="link-button" id="find-pages">
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                  <circle cx="8.5" cy="8.5" r="5.25"></circle>
                  <path d="m12.5 12.5 4.25 4.25"></path>
                </svg>
                <span>{hero.findPages}</span>
              </button>
              <span class="url-count" id="url-count" aria-live="polite"></span>
              <button type="submit" class="btn btn-primary save" data-save>
              <span>{hero.save}</span>
              <span class="btn-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 3.5v9.5m0 0 4-4m-4 4-4-4M4.5 16.5h11"></path></svg>
              </span>
            </button>
            </div>
            <div class="picker" id="picker" hidden>
              <div class="picker-head">
                <p id="picker-title" class="picker-title"></p>
                <button type="button" class="link-button" id="picker-all">{hero.selectAll}</button>
                <button type="button" class="link-button" id="picker-none">{hero.clearSelection}</button>
              </div>
              <ul class="picker-list" id="picker-list" aria-labelledby="picker-title"></ul>
              <button type="button" class="btn btn-ghost picker-add" id="picker-add">{hero.addPages}</button>
            </div>
          </div>

          <div class="choices">
            <fieldset class="choice">
              <legend>{hero.deviceLegend}</legend>
              <div class="segmented">
                {
                  DEVICES.map((d) => (
                    <label>
                      <input type="radio" name="device" value={d.value} checked={d.value === 'desktop'} />
                      <svg class="seg-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" set:html={ICONS[d.value]} />
                      <span>{d.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="choice">
              <legend>{hero.outputLegend}</legend>
              <div class="segmented">
                {
                  OUTPUTS.map((o) => (
                    <label>
                      <input type="radio" name="output" value={o.value} checked={o.value === 'zip'} />
                      <svg class="seg-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" set:html={ICONS[o.value]} />
                      <span>{o.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <details class="more">
            <summary>
              <svg class="more-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M3 6h7m4 0h3M3 14h3m4 0h7"></path>
                <circle cx="12" cy="6" r="2"></circle>
                <circle cx="8" cy="14" r="2"></circle>
              </svg>
              <span>{hero.moreOptions}</span>
              <span class="more-count" data-options-count aria-hidden="true" hidden></span>
              <svg class="chevron" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m6 8 4 4 4-4"></path></svg>
            </summary>
          <fieldset class="options">
            <legend class="visually-hidden">{hero.optionsLegend}</legend>
            {
              OPTIONS.map((o, i) => (
                <label class="chip" data-hint={o.hint} style={`--n: ${i}`}>
                  <input type="checkbox" name={o.name} aria-describedby={`hint-${o.name}`} />
                  <span class="chip-check" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="12" height="12"><path d="m3.5 8.5 3 3 6-7"></path></svg>
                  </span>
                  <span>{o.title}</span>
                  <span class="visually-hidden" id={`hint-${o.name}`}>{o.hint}</span>
                </label>
              ))
            }
          </fieldset>
          </details>
          <div class="status-row">
            <p class="status" id="status" role="status" aria-live="polite"></p>
            <p class="hint-line" aria-hidden="true" data-hint-line></p>
            <a class="result-link" href="#result" hidden>{t.result.title}</a>
          </div>
        </form>
      </div>

      <button type="button" class="try" data-try-example>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <circle cx="10" cy="10" r="7.75"></circle>
          <path d="M7.9 7.9a2.15 2.15 0 1 1 3.05 1.95c-.6.3-.95.8-.95 1.4v.25"></path>
          <circle class="dot" cx="10" cy="13.9" r=".9"></circle>
        </svg>
        <span>{hero.tryExample}</span>
      </button>
    </div>

    <div class="visual">
      <ArchiveScene />
    </div>
  </div>
</section>

<script type="application/json" id="saver-text" set:html={JSON.stringify(clientText)} />

<script>
  import '../scripts/saver';
</script>

<style>
  /* Two columns on a laptop: headline, form and options on the left, the archive drawing on the
     right. The whole form, Save button included, is in view without scrolling. */
  .hero {
    --glow-x: 76%;
    --glow-y: 46%;
    --grid-mask: radial-gradient(45% 90% at 76% 100%, black 15%, transparent 72%);
    padding-top: clamp(6.5rem, 9vw, 8rem);
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr);
    grid-template-areas: 'copy visual';
    gap: var(--s-6) clamp(2rem, 4vw, 4rem);
    /* Top-aligned, so opening the options never moves the drawing. */
    align-items: start;
  }

  /* ---- Copy: the one page-load sequence, together with the drawing assembling ------------- */
  .copy {
    grid-area: copy;
    container-type: inline-size;
  }

  /* The drawing may reach into the right-hand gutter. */
  .visual {
    grid-area: visual;
    margin-top: clamp(0rem, 2.5vw, 2.5rem);
    margin-right: calc(-0.5 * var(--gutter));
  }

  /* Capped by the column width as well as the viewport, and by the length of the longer line, so
     each line of a short headline fits on one row and a long translation stays at two or three
     rows (about 0.37em per character in the condensed display face). */
  h1 {
    font-size: min(var(--fs-hero), max(8cqi, calc(255cqi / var(--chars, 22))));
    font-weight: 700;
    font-stretch: 90%;
    line-height: 1;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  h1 .line {
    display: block;
    animation: copy-in 1000ms var(--ease-spring) 100ms backwards;
  }

  /* The second line in the logo's blue, as in the wordmark. The padding keeps descenders inside
     the clipped background. */
  h1 .accent {
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    background: linear-gradient(100deg, var(--logo-blue-1), var(--logo-blue-2) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation-delay: 180ms;
  }

  .lead {
    max-width: 34rem;
    margin-top: var(--s-5);
    color: var(--muted);
    font-size: var(--fs-md);
    line-height: 1.6;
    text-wrap: pretty;
    animation: copy-in 1000ms var(--ease-spring) 260ms backwards;
  }

  @keyframes copy-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  /* ---- Console: the tool itself, a plate in a hairline tray ------------------------------- */
  .console {
    margin-top: var(--s-6);
    animation: copy-in 1000ms var(--ease-spring) 340ms backwards;
  }

  .console > .core {
    position: relative;
    container-type: inline-size;
    padding: var(--s-4);
  }

  .field-label {
    display: block;
    margin: 0 var(--s-4) var(--s-2);
    line-height: 1.5;
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .field {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.3125rem;
    padding-left: var(--s-4);
    border-radius: var(--r-pill);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: box-shadow 200ms var(--ease-out);
  }

  .field:hover {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .field:focus-within {
    box-shadow:
      inset 0 0 0 1px var(--accent),
      0 0 0 4px var(--accent-soft);
  }

  .field-icon {
    flex: none;
    fill: none;
    stroke: var(--faint);
    stroke-width: 1.5;
  }

  input[type='url'] {
    flex: 1;
    min-width: 0;
    height: 3rem;
    padding: 0 var(--s-2);
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-md);
  }

  input[type='url']::placeholder,
  textarea::placeholder {
    color: var(--faint);
    opacity: 1;
  }

  /* The ring is drawn on the whole field by .field:focus-within. */
  input[type='url']:focus,
  textarea:focus {
    outline: none;
  }

  .save {
    flex: none;
    min-height: 3rem;
  }

  .save:disabled .btn-icon svg {
    animation: nudge 900ms var(--ease-in-out) infinite alternate;
  }

  @keyframes nudge {
    to {
      transform: translateY(3px);
    }
  }

  /* ---- Segmented controls: what to save, version, format --------------------------------- */
  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0;
    padding: 3px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .segmented label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.875rem;
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 250ms var(--ease-out),
      color 250ms var(--ease-out),
      box-shadow 250ms var(--ease-out);
  }

  .segmented label:hover {
    color: var(--ink);
  }

  .seg-icon {
    flex: none;
    margin-right: 0.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
    transition: opacity 250ms var(--ease-out);
  }

  .segmented label:has(input:checked) .seg-icon {
    opacity: 1;
  }

  .segmented input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .segmented label:has(input:checked) {
    background: var(--surface-2);
    color: var(--ink);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      inset 0 1px 0 var(--highlight);
  }

  .segmented label:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .modes {
    margin-bottom: var(--s-3);
  }

  /* Wide enough: the One page / Several pages switch sits on the label's line, top right. */
  @container (min-width: 30rem) {
    .modes {
      position: absolute;
      top: var(--s-4);
      right: var(--s-4);
      margin: 0;
    }

    .field-label {
      display: flex;
      align-items: center;
      min-height: 2.625rem;
      margin-right: 16rem;
    }
  }

  /* ---- Several pages ------------------------------------------------------------------- */
  .entry[hidden] {
    display: none;
  }

  .field-multi {
    padding: var(--s-1);
    border-radius: var(--r-lg);
  }

  textarea {
    flex: 1;
    min-width: 0;
    min-height: 7.5rem;
    padding: var(--s-2) var(--s-3);
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.7;
    resize: vertical;
  }

  textarea::placeholder {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
  }

  .multi-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-3);
    padding-inline: var(--s-1);
  }

  .multi-bar .save {
    margin-left: auto;
  }

  .url-count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.5rem;
    padding: 0 var(--s-3);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }

  .link-button:hover {
    background: var(--shell);
  }

  .link-button:disabled {
    color: var(--muted);
    cursor: progress;
  }

  .link-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .picker {
    margin-top: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-md);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .picker[hidden] {
    display: none;
  }

  .picker-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
  }

  .picker-title {
    margin-right: auto;
    padding-left: var(--s-2);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .picker-list {
    max-height: 15rem;
    margin: var(--s-2) 0 var(--s-3);
    padding: 0;
    overflow: auto;
    list-style: none;
    overscroll-behavior: contain;
  }

  .picker-list :global(label) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-3);
    align-items: start;
    padding: var(--s-2);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .picker-list :global(label:hover) {
    background: var(--surface-2);
  }

  .picker-list :global(input) {
    grid-row: span 2;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0.125rem 0 0;
    accent-color: var(--accent);
  }

  .picker-list :global(.page-title) {
    overflow: hidden;
    font-size: var(--fs-sm);
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .picker-list :global(.page-url) {
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .picker-add {
    min-height: 2.5rem;
    font-size: var(--fs-sm);
  }

  /* ---- Version and format: side by side when both fit, otherwise one under the other ------ */
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-4);
    padding: 0 var(--s-1);
  }

  .choice {
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice .segmented {
    display: flex;
    width: 100%;
  }

  .choice .segmented label {
    flex: 1 1 auto;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.5625rem;
  }

  .choice legend {
    margin-bottom: var(--s-1);
    padding: 0 0 0 var(--s-2);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.3;
  }

  /* ---- Options: folded away under "Customize your download" ----------------------------- */
  .more {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
  }

  .more summary {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    width: fit-content;
    min-height: 2.75rem;
    margin-top: var(--s-2);
    padding: 0 var(--s-3);
    border-radius: var(--r-pill);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    background: var(--shell);
  }

  .more summary:focus-visible {
    outline-offset: 1px;
  }

  .more-icon,
  .chevron {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .more-icon {
    color: var(--muted);
  }

  .chevron {
    margin-left: calc(-1 * var(--s-1));
    color: var(--muted);
    transition: transform 400ms var(--ease-spring);
  }

  .more[open] .chevron {
    transform: rotate(180deg);
  }

  /* How many options are on, so a folded panel never hides a choice. */
  .more-count {
    display: grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding: 0 0.375rem;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
