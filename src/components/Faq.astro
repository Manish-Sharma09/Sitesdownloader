---
import { LANGUAGES, format, getLangFromUrl, pageParams, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// FAQ rich results: the questions and answers listed below, as one FAQPage JSON-LD block.
// Built from the locale file, so every language gets its own and it never drifts from the page.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LANGUAGES[lang].htmlLang,
  mainEntity: t.faq.items.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
// Indented so it reads like a hand-written block; "<" is escaped so an answer can never close the tag.
const faqJsonLd = JSON.stringify(faqSchema, null, 2).replace(/</g, '\\u003c');
---

<section class="faq section band" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-head head reveal">
      <h2 id="faq-title">{t.faq.title}</h2>
      <p set:html={format(t.faq.leadHtml, pageParams(lang))} />
    </div>
    <div class="list">
      {
        t.faq.items.map((faq) => (
          <details class="reveal">
            <summary>
              <h3>{faq.question}</h3>
              <span class="icon" aria-hidden="true" />
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={faqJsonLd} />

<style>
  .head :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .head :global(a:hover) {
    color: var(--accent);
  }

  /* Two columns of question cards, flowing like masonry so open answers don't leave holes. */
  .list {
    margin-top: var(--s-7);
    columns: 2;
    column-gap: var(--s-4);
  }

  details {
    break-inside: avoid;
    margin-bottom: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      inset 0 1px 0 var(--highlight);
    transition: box-shadow 250ms var(--ease-out);
  }

  details:hover,
  details[open] {
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      inset 0 1px 0 var(--highlight);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3rem;
    padding: var(--s-5);
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* A plus that turns into a cross when the answer opens. */
  .icon {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      transform 400ms var(--ease-spring),
      background-color 250ms var(--ease-out);
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 31% auto;
    height: 1.5px;
    margin-top: -0.75px;
    border-radius: 1px;
    background: var(--ink);
  }

  .icon::after {
    transform: rotate(90deg);
  }

  details[open] .icon {
    transform: rotate(135deg);
    background: var(--accent);
    box-shadow: none;
  }

  details[open] .icon::before,
  details[open] .icon::after {
    background: var(--on-accent);
  }

  details p {
    padding: 0 var(--s-5) var(--s-5);
    color: var(--muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  details[open] p {
    animation: answer-in 400ms var(--ease-spring);
  }

  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 820px) {
    .list {
      columns: 1;
    }
  }
</style>
