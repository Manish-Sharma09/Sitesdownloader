---
// Three real steps, so they are numbered. Each one shows the moment it describes: the address going
// in, the options, the archive opening into files. The cards are a sticky stack: each pins below the
// header and the next one slides over it as you scroll (plain position: sticky, no script). On small
// screens they simply stack.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const [paste, choose, open] = t.steps.items;
const { options } = t.hero;
---

<section class="steps section" id="how-it-works" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="steps-title">{t.steps.title}</h2>
      <p>{t.steps.lead}</p>
    </div>

    <ol class="stack">
      <li class="step" style="--n: 0">
        <div class="bezel">
          <div class="core card">
            <div class="text">
              <span class="num" aria-hidden="true">1</span>
              <h3>{paste.title}</h3>
              <p>{paste.text}</p>
            </div>
            <div class="well" aria-hidden="true">
              <span class="mini-field">
                <svg viewBox="0 0 20 20" width="16" height="16">
                  <circle cx="10" cy="10" r="7.25"></circle>
                  <path d="M2.75 10h14.5M10 2.75c2 2 3 4.4 3 7.25s-1 5.25-3 7.25c-2-2-3-4.4-3-7.25s1-5.25 3-7.25Z"></path>
                </svg>
                <span class="mini-url">example.com/offer</span>
                <span class="mini-btn">{t.hero.save}</span>
              </span>
            </div>
          </div>
        </div>
      </li>
      <li class="step" style="--n: 1">
        <div class="bezel">
          <div class="core card">
            <div class="text">
              <span class="num" aria-hidden="true">2</span>
              <h3>{choose.title}</h3>
              <p>{choose.text}</p>
            </div>
            <div class="well" aria-hidden="true">
              <span class="mini-options">
                <span class="mini-option is-on"><span class="mini-switch"></span>{options.cleanCopy.title}</span>
                <span class="mini-option"><span class="mini-switch"></span>{options.renameAssets.title}</span>
                <span class="mini-option is-on"><span class="mini-switch"></span>{options.simplified.title}</span>
              </span>
            </div>
          </div>
        </div>
      </li>
      <li class="step" style="--n: 2">
        <div class="bezel">
          <div class="core card">
            <div class="text">
              <span class="num" aria-hidden="true">3</span>
              <h3>{open.title}</h3>
              <p>{open.text}</p>
            </div>
            <div class="well" aria-hidden="true">
              <span class="mini-archive">
                <span class="zip-file"><b></b>example.com.zip</span>
                <span class="mini-tree">
                  <span style="--kind: var(--ink)">index.html</span>
                  <span style="--kind: var(--kind-css)">css/</span>
                  <span style="--kind: var(--kind-image)">images/</span>
                  <span style="--kind: var(--kind-font)">fonts/</span>
                </span>
              </span>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .stack {
    display: grid;
    gap: var(--s-6);
    margin: var(--s-8) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Each card pins a little lower than the one before, so their edges show as a stack. */
  .step {
    position: sticky;
    top: calc(6.5rem + var(--n) * 1.5rem);
  }

  /* Stacked cards cover each other, so the tray is opaque: the same tint, mixed into the canvas. */
  .step > .bezel {
    background: color-mix(in srgb, var(--ink) 4%, var(--bg));
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 21rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .num {
    display: block;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 4vw, 7rem);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 0.85;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--accent) 70%, var(--ink));
  }

  h3 {
    margin-top: var(--s-5);
    font-size: var(--fs-xl);
    font-weight: 650;
    font-stretch: 94%;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .text p {
    max-width: 26rem;
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: var(--fs-md);
    text-wrap: pretty;
  }

  /* ---- Illustration wells: an inset tray with a fine grid ------------------------------- */
  .well {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 15rem;
    height: 100%;
    padding: var(--s-5);
    border-radius: var(--r-md);
    background-color: var(--bg);
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }

  /* ---- Step 1: the address going in --------------------------------------------------- */
  .mini-field {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    max-width: 100%;
    padding: var(--s-1) var(--s-1) var(--s-1) var(--s-3);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--accent),
      0 0 0 4px var(--accent-soft);
  }

  .mini-field svg {
    flex: none;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
  }

  .mini-url {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* A typing caret after the address. */
  .mini-url::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--ink);
  }

  .mini-btn {
    flex: none;
    padding: 0.375rem var(--s-3);
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--fs-sm);
    font-weight: 680;
  }

  /* ---- Step 2: switches ---------------------------------------------------------------- */
  .mini-options {
    display: grid;
    gap: var(--s-2);
    width: min(100%, 16rem);
    padding: var(--s-2);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mini-option {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
    padding: 0.125rem var(--s-1);
    overflow: hidden;
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mini-switch {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1rem;
    border-radius: var(--r-pill);
    background: var(--switch-off);
  }

  .mini-switch::after {
    content: '';
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(13 21 51 / 0.25);
  }

  .is-on .mini-switch {
    background: var(--accent);
  }

  .is-on .mini-switch::after {
    transform: translateX(0.75rem);
    background: var(--on-accent);
  }

  /* ---- Step 3: the archive opening into files ------------------------------------------- */
  .mini-archive {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    max-width: 100%;
  }

  .zip-file {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-2);
    border-radius: var(--r-sm);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .zip-file b {
    width: 0.875rem;
    height: 1.125rem;
    border-radius: 3px;
    background: repeating-linear-gradient(180deg, var(--on-accent) 0 2px, var(--accent) 2px 4px);
    border: 2px solid var(--accent);
  }

  .mini-tree {
    display: grid;
    gap: 0.125rem;
    margin-left: 0.875rem;
    padding-left: var(--s-4);
    border-left: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .mini-tree span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .mini-tree span::before {
    content: '';
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 2px;
    background: var(--kind);
  }

  /* One column: the illustration goes under the words, and the stack stops pinning. */
  @media (max-width: 820px) {
    .step {
      position: static;
    }

    .card {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .well {
      min-height: 11rem;
    }
  }
</style>
