---
// Closing call to action: one large statement in a glass panel, lit like the hero. A zipper runs
// along the top of the panel and closes as the panel scrolls into view (scroll-driven animation;
// a static closed zipper elsewhere and with reduced motion).
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<section class="cta-band wrap" aria-labelledby="cta-title">
  <div class="bezel">
    <div class="core panel stage">
      <div class="zipper" aria-hidden="true"><span class="pull"></span></div>
      <div class="content reveal">
        <h2 id="cta-title">{t.cta.title}</h2>
        <p>{t.cta.text}</p>
        <a href={`${home === '/' ? '' : home}/#top`} class="btn btn-primary" data-focus-url>
          <span>{t.cta.button}</span>
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="16" height="16"><path d="M10 4v10m0 0 4-4m-4 4-4-4"></path></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(5rem, 10vw, 8rem);
  }

  .panel {
    --glow-x: 50%;
    --glow-y: 105%;
    padding: clamp(4.5rem, 9vw, 7.5rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 6.5rem);
    text-align: center;
  }

  .content {
    display: grid;
    justify-items: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  h2 {
    font-size: var(--fs-display);
    font-weight: 700;
    font-stretch: 92%;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p {
    max-width: 32rem;
    margin-top: var(--s-5);
    color: var(--muted);
    font-size: var(--fs-md);
    text-wrap: pretty;
  }

  .btn {
    margin-top: var(--s-7);
  }

  /* ---- Zipper along the top edge of the panel --------------------------------------------- */
  .zipper {
    --teeth: var(--surface);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1.5rem;
    background-color: var(--accent);
    background-image:
      repeating-linear-gradient(90deg, var(--teeth) 0 5px, transparent 5px 11px),
      repeating-linear-gradient(90deg, transparent 0 5.5px, var(--teeth) 5.5px 10.5px, transparent 10.5px 11px);
    background-size:
      100% 10px,
      100% 10px;
    background-position:
      0 3px,
      0 9px;
    background-repeat: no-repeat;
    container-type: inline-size;
  }

  .pull {
    position: absolute;
    top: 0.125rem;
    left: var(--s-4);
    width: 2.75rem;
    height: 1.25rem;
    border-radius: 6px;
    background: var(--teeth);
    box-shadow: 0 0 0 2px var(--accent);
    transform: translateX(calc(100cqw - 2.75rem - 2 * var(--s-4)));
  }

  .pull::after {
    content: '';
    position: absolute;
    inset: 0.4rem 0.7rem;
    border-radius: 2px;
    background: var(--accent);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pull {
        animation: cta-zip var(--ease-in-out) both;
        animation-timeline: view();
        animation-range: entry 20% cover 50%;
      }
    }
  }

  @keyframes cta-zip {
    from {
      transform: translateX(0);
    }
  }
</style>
