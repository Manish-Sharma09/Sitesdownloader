---
// The result panel: hidden until an archive is ready, then filled in by src/scripts/result.ts
// from the archive's own manifest. Headings and labels are rendered here, in the page's language.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const R = t.result;
---

<section class="result" id="result" aria-labelledby="result-title" tabindex="-1" hidden>
  <div class="wrap">
    <div class="bezel">
    <div class="core sheet">
      <header class="head">
        <div>
          <h2 id="result-title">{R.title}</h2>
          <p class="meta" data-r="meta"></p>
        </div>
        <button type="button" class="btn btn-primary" data-r="download-all">{R.downloadAgain}</button>
      </header>

      <div class="summary">
        <p class="score"><span class="score-value" data-r="score"></span> <span class="score-label">{R.score}</span></p>
        <div class="meter" aria-hidden="true"><span data-r="meter"></span></div>
        <ul class="facts" data-r="facts"></ul>
        <p class="hint">{R.scoreHint}</p>
        <p class="hint" data-r="live"></p>
      </div>

      <div class="tabs" role="tablist" aria-labelledby="result-title">
        <button type="button" role="tab" id="tab-files" aria-controls="panel-files" aria-selected="true">{R.tabs.files}</button>
        <button type="button" role="tab" id="tab-problems" aria-controls="panel-problems" aria-selected="false" tabindex="-1">
          {R.tabs.problems}<span class="badge" data-r="problem-count"></span>
        </button>
        <button type="button" role="tab" id="tab-insights" aria-controls="panel-insights" aria-selected="false" tabindex="-1">
          {R.tabs.insights}
        </button>
      </div>

      <div class="panel" role="tabpanel" id="panel-files" aria-labelledby="tab-files">
        <p class="hint" data-r="files-hint"></p>
        <ul class="tree" data-r="tree" translate="no"></ul>
        <div class="selection-bar" data-r="selection-bar">
          <p data-r="selection"></p>
          <button type="button" class="btn btn-primary" data-r="download-selected">{R.downloadSelected}</button>
        </div>
      </div>

      <div class="panel" role="tabpanel" id="panel-problems" aria-labelledby="tab-problems" hidden>
        <div class="removed" data-r="removed"></div>
        <ul class="problems" data-r="problems"></ul>
        <p class="hint" data-r="more-problems"></p>
      </div>

      <div class="panel" role="tabpanel" id="panel-insights" aria-labelledby="tab-insights" hidden>
        <div class="insights">
          <section class="card">
            <h3>{R.insights.colors}</h3>
            <ul class="swatches" data-r="colors"></ul>
            <p class="group-label" data-r="neutrals-label">{R.insights.neutrals}</p>
            <ul class="swatches" data-r="neutrals"></ul>
            <p class="muted" data-r="colors-empty">{R.insights.none}</p>
            <p class="muted" data-r="css-vars"></p>
          </section>
          <section class="card">
            <h3>{R.insights.fonts}</h3>
            <ul class="fonts" data-r="fonts"></ul>
          </section>
          <section class="card">
            <h3>{R.insights.weight}</h3>
            <div class="weight-bar" data-r="weight-bar" aria-hidden="true"></div>
            <ul class="weight" data-r="weight"></ul>
          </section>
          <section class="card">
            <h3>{R.insights.tech}</h3>
            <div data-r="tech"></div>
          </section>
          <section class="card wide">
            <h3>{R.insights.seo}</h3>
            <dl class="seo" data-r="seo"></dl>
          </section>
        </div>
        <p class="visually-hidden" role="status" data-r="copy-status"></p>
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .result {
    padding-block: clamp(2.5rem, 5vw, 4rem) 0;
    scroll-margin-top: 5.5rem;
  }

  .result:focus {
    outline: none;
  }

  .sheet {
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  h2 {
    font-size: var(--fs-xl);
    font-weight: 650;
    font-stretch: 92%;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-4);
    margin-top: var(--s-1);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .meta :global(.mono) {
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .head .btn[hidden] {
    display: none;
  }

  /* ---- Score ----------------------------------------------------------------------------- */
  .summary {
    margin-top: var(--s-5);
    padding: var(--s-5);
    border-radius: var(--r-md);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .score {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-3);
  }

  .score-value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 2.5vw, 4rem);
    font-weight: 700;
    font-stretch: 90%;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .score-label {
    color: var(--muted);
    font-size: var(--fs-lg);
  }

  .meter {
    height: 6px;
    margin-top: var(--s-4);
    border-radius: var(--r-pill);
    background: var(--line);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--ok);
    transform-origin: 0 50%;
    transition: transform 700ms var(--ease-out);
  }

  .result[data-score='mid'] .meter span {
    background: var(--accent);
  }

  .result[data-score='low'] .meter span {
    background: var(--danger);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .facts :global(li) {
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .hint {
    max-width: 48rem;
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .hint:empty,
  .hint[hidden] {
    display: none;
  }

  /* ---- Tabs ------------------------------------------------------------------------------ */
  .tabs {
    display: flex;
    gap: var(--s-1);
    margin-top: var(--s-5);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }

  [role='tab'] {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding: 0 var(--s-4);
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-weight: 640;
    white-space: nowrap;
    cursor: pointer;
  }

  [role='tab']:hover {
    color: var(--ink);
  }

  [role='tab']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 200ms var(--ease-out);
  }

  [role='tab'][aria-selected='true'] {
    color: var(--ink);
  }

  [role='tab'][aria-selected='true']::after {
    transform: scaleX(1);
  }

  .badge {
    min-width: 1.5rem;
    padding: 0 0.375rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--danger) 14%, transparent);
    color: var(--danger);
    font-size: var(--fs-xs);
    line-height: 1.5rem;
    text-align: center;
  }

  .badge[hidden] {
    display: none;
  }

  .panel {
    padding-top: var(--s-4);
  }

  .panel[hidden] {
    display: none;
  }

  /* ---- Files ------------------------------------------------------------------------------ */
  .tree {
    max-height: 30rem;
    margin: var(--s-3) 0 0;
    padding: var(--s-2);
    overflow: auto;
    border-radius: var(--r-md);
    background: var(--code-bg);
    box-shadow: inset 0 0 0 1px var(--code-line);
    color: var(--code-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    list-style: none;
    overscroll-behavior: contain;
  }

  .tree[hidden],
  .selection-bar[hidden] {
    display: none;
  }

  .tree :global(ul) {
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--code-line);
    margin-left: 0.6rem;
    list-style: none;
  }

  .tree :global(.row) {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--s-2);
    min-height: 2rem;
    padding: 0 var(--s-2);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .tree :global(.row:hover) {
    background: rgb(237 240 248 / 0.06);
  }

  .tree :global(input) {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .tree :global(input:disabled) {
    opacity: 0.45;
  }

  .tree :global(.file .row)::before {
    content: '';
    grid-column: 2;
    grid-row: 1;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--kind);
  }

  .tree :global(.file[style*='--ink'] .row)::before {
    background: var(--kind-html);
  }

  .tree :global(.name) {
    grid-column: 3;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tree :global(.folder > .row .name) {
    grid-column: 2 / 4;
    color: #edf0f8;
    font-weight: 600;
  }

  .tree :global(.size) {
    grid-column: 4;
    color: var(--code-muted);
    font-size: var(--fs-xs);
  }

  .tree :global(.row:has(input:not(:checked):not(:indeterminate))) :global(.name) {
    color: var(--code-muted);
    text-decoration: line-through;
  }

  .selection-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .selection-bar p {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* ---- Problems and removed items ----------------------------------------------------------- */
  h3 {
    font-size: var(--fs-base);
    font-weight: 650;
    font-stretch: 95%;
    letter-spacing: -0.01em;
  }

  .removed:empty {
    display: none;
  }

  .removed {
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  .result :global(.group-label) {
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .result :global(.group-label[hidden]) {
    display: none;
  }

  .result :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .result :global(.chips li) {
    padding: 0.125rem var(--s-3);
    border-radius: var(--r-pill);
    background: var(--surface-2);
    font-size: var(--fs-sm);
    font-weight: 560;
  }

  .problems {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .problems :global(li) {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .problems :global(li.empty) {
    display: block;
    color: var(--ok);
    font-weight: 600;
  }

  .problems :global(.kind) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--muted);
    font-weight: 600;
  }

  .problems :global(.kind)::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--kind);
  }

  .problems :global(a) {
    overflow: hidden;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
    text-underline-offset: 0.2em;
  }

  .problems :global(.reason) {
    color: var(--ink);
  }

  /* ---- Insights ----------------------------------------------------------------------------- */
  .insights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .card {
    padding: var(--s-5);
    border-radius: var(--r-md);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .card.wide {
    grid-column: 1 / -1;
  }

  .result :global(.muted) {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .result :global(.muted:empty),
  .result :global(.muted[hidden]) {
    display: none;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .swatches:empty {
    display: none;
  }

  .swatches :global(.swatch) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.25rem;
    padding: 0.25rem var(--s-3) 0.25rem 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    cursor: copy;
    transition: border-color 160ms var(--ease-out);
  }

  .swatches :global(.swatch:hover) {
    border-color: var(--line-strong);
  }

  .swatches :global(i) {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(13 21 51 / 0.12);
  }

  .swatches :global(code) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .fonts {
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .fonts :global(li) {
    display: grid;
    gap: 0.125rem;
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--line);
  }

  .fonts :global(li:last-child) {
    border-bottom: 0;
  }

  .weight-bar {
    display: flex;
    gap: 2px;
    height: 0.75rem;
    margin-top: var(--s-3);
    border-radius: var(--r-pill);
    overflow: hidden;
  }

  .weight-bar :global(span) {
    min-width: 3px;
  }

  .weight {
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }

  .weight :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 5.5rem;
    gap: var(--s-3);
    padding: var(--s-1) 0;
  }

  .weight :global(.kind-name) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
  }

  .weight :global(.kind-name)::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 3px;
    background: var(--kind);
  }

  .weight :global(.size) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .seo {
    display: grid;
    grid-template-columns: minmax(9rem, max-content) minmax(0, 1fr);
    gap: var(--s-2) var(--s-5);
    margin: var(--s-3) 0 0;
    font-size: var(--fs-sm);
  }

  .seo :global(dt) {
    color: var(--muted);
  }

  .seo :global(dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .seo :global(dd.mono) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .seo :global(.missing) {
    color: var(--danger);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .insights {
      grid-template-columns: minmax(0, 1fr);
    }

    .problems :global(li) {
      grid-template-columns: minmax(0, 1fr);
    }

    .seo {
      grid-template-columns: minmax(0, 1fr);
    }

    .seo :global(dd) {
      margin-bottom: var(--s-2);
    }
  }
</style>
